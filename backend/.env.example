# ==============================================================================
# Fake Review Detection v2 - Backend Environment Configuration
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# MongoDB Connection
# Note: Connect to MongoDB server (mongod), not MongoDB Compass
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fake_review_detection

# Frontend Origin for CORS (e.g. Flask Web Application)
FLASK_ORIGIN=http://127.0.0.1:5000

# Model Configuration
# Options:
#   - deberta_fusion  : DeBERTa-v3-base + Tabular Metadata Fusion (Step 7 - Planned)
#   - deberta_text    : DeBERTa-v3-base Text-Only (Step 6)
#   - baseline        : TF-IDF + LightGBM (Step 5)
MODEL_TYPE=deberta_text

# Local Trained Model Directory & ML Service Gateway
MODEL_DIR=backend/models/deberta_fp32_final
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8000

# Custom Artifacts Path (Leave empty to use MODEL_DIR or training/artifacts/<model_type>)
MODEL_ARTIFACTS_PATH=

# Operational Settings
API_V1_STR=/api/v1
MAX_BATCH_ROWS=500
MONGODB_TIMEOUT_MS=3000
